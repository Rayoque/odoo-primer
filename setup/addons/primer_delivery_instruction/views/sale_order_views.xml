<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_primer_instructions" model="ir.ui.view">
        <field name="name">sale.order.form.primer.instructions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_primer_instructions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck">
                    <field name="primer_instruction_count" widget="statinfo" string="Instructions"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Delivery instructions" name="primer_instructions">
                    <field name="primer_instruction_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="handling"/>
                            <field name="instruction"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
