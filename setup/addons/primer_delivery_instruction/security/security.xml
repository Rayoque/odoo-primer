<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_primer" model="ir.module.category">
        <field name="name">Primer Delivery</field>
        <field name="description">Access to delivery instruction records</field>
        <field name="sequence">80</field>
    </record>

    <record id="group_primer_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_primer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_primer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_primer"/>
        <field name="implied_ids" eval="[(4, ref('group_primer_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
